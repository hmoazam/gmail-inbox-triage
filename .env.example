# Copy this file to .env and fill in your own values, then:  source .env
# Every variable is OPTIONAL — the app runs with sensible defaults — but setting
# USER_NAME and INTERNAL_DOMAIN makes classification noticeably better.

# ── Who "me" is ───────────────────────────────────────────────────────────────
# Your display name as it appears in emails. Used to detect actions on you.
export CLEANUP_USER_NAME="Your Name"
# Your email. Leave unset to auto-detect from your Gmail profile.
# export CLEANUP_USER_EMAIL="you@example.com"
# Your company domain. Threads where everyone is on this domain are "internal".
export CLEANUP_INTERNAL_DOMAIN="example.com"

# ── Classification backend ────────────────────────────────────────────────────
#   claude_cli    (default) uses your local, already-authenticated `claude` CLI
#   anthropic_api uses the Anthropic API directly (needs ANTHROPIC_API_KEY)
#   databricks_fm uses a Databricks Foundation Model serving endpoint
export CLEANUP_BACKEND="claude_cli"
# Model id. Blank = CLI default for claude_cli; a model id for anthropic_api;
# the serving endpoint name for databricks_fm.
# export CLEANUP_MODEL=""
# Only for anthropic_api:
# export ANTHROPIC_API_KEY="sk-ant-..."

# ── Gmail API quota project (optional) ────────────────────────────────────────
# Only needed if Gmail returns a "user project" / quota error. Set to your own
# Google Cloud project id.
# export GMAIL_QUOTA_PROJECT="your-gcp-project-id"

# ── Tuning ────────────────────────────────────────────────────────────────────
# export CLEANUP_THREAD_BATCH_SIZE="30"
# export CLEANUP_PER_MSG_BODY_CHARS="6000"

# ── Databricks (only for the databricks_fm backend) ───────────────────────────
# export CLEANUP_DATABRICKS_PROFILE="DEFAULT"
